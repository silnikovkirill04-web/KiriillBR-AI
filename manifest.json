python - <<'EOF'
import json
sha = "f9873820b6765d0d78950812c8cb4331c3aa9bf21f244f72b55ffa06a8dfef30"
p = "manifest.json"
m = json.load(open(p, encoding="utf-8"))
m["version"] = "3.2.7"
m["sha256"] = sha
m["notes"] = "Чёрный список по никам, авто-блок джейлбрейков, меню ЧС."
json.dump(m, open(p, "w", encoding="utf-8"), ensure_ascii=False, indent=2)
print("OK")
print("version:", m["version"])
print("sha256 :", m["sha256"])
EOF
